# Puerto del server (Render lo define solo en producción)
PORT=3001
# Orígenes permitidos para CORS y Socket.IO, separados por coma.
# Para probar desde el celu en la misma red, agregá la IP de tu compu, ej.:
# CLIENT_ORIGIN=http://localhost:5173,http://192.168.0.10:5173
CLIENT_ORIGIN=http://localhost:5173
# info | warn | error
LOG_LEVEL=info
# Proxies delante del server cuyo X-Forwarded-For se cree para saber la IP real (Render: 1).
# Con 0 se ignora el header (en local no hay proxy).
TRUST_PROXY_HOPS=0
# Salas que puede crear una misma IP por minuto.
ROOMS_PER_MINUTE=10

# ── Cuentas (docs/specs/M9-cuentas.md) ──
# off: sin cuentas (todos invitados). memory: login de prueba por nombre, solo para desarrollo
# (el server no arranca así con NODE_ENV=production). supabase: login con Google en producción.
AUTH_MODE=off
# Solo con AUTH_MODE=supabase. La URL del proyecto: https://<proyecto>.supabase.co
SUPABASE_URL=
# Solo con AUTH_MODE=supabase. La "service_role" de Supabase → Project Settings → API.
# SECRETA: solo acá y en Render. Nunca en la web, nunca en el repo, nunca en un log.
SUPABASE_SERVICE_ROLE_KEY=
# Las estadísticas cuentan partidas de al menos esta cantidad de segundos.
STATS_MIN_GAME_SECONDS=300
