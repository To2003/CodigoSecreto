# Puerto del server (Render lo define solo en producción)
PORT=3001
# Orígenes permitidos para CORS y Socket.IO, separados por coma.
# Para probar desde el celu en la misma red, agregá la IP de tu compu, ej.:
# CLIENT_ORIGIN=http://localhost:5173,http://192.168.0.10:5173
CLIENT_ORIGIN=http://localhost:5173
# info | warn | error
LOG_LEVEL=info
# Proxies delante del server cuyo X-Forwarded-For se cree para saber la IP real (Render: 1).
# Con 0 se ignora el header (en local no hay proxy).
TRUST_PROXY_HOPS=0
# Salas que puede crear una misma IP por minuto.
ROOMS_PER_MINUTE=10
