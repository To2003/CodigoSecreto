# Puerto del server (Render lo define solo en producción)
PORT=3001
# Orígenes permitidos para CORS y Socket.IO, separados por coma.
# Para probar desde el celu en la misma red, agregá la IP de tu compu, ej.:
# CLIENT_ORIGIN=http://localhost:5173,http://192.168.0.10:5173
CLIENT_ORIGIN=http://localhost:5173
# info | warn | error
LOG_LEVEL=info
