# URL del server (en dev, el server de apps/server)
VITE_SERVER_URL=http://localhost:3001

# Cuentas (opcionales, docs/specs/M9-cuentas.md). Sin estas, todos juegan de invitados.
# La URL y la "anon public" key de Supabase (Project Settings → API). Son públicas por diseño;
# la service role key NUNCA va acá.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Solo para desarrollo con el server en AUTH_MODE=memory: login de prueba por nombre.
# VITE_AUTH_MODE=memory
