{
  "name": "clave",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" --parallel --stream dev",
    "build": "pnpm -r --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p . && pnpm -r --if-present typecheck",
    "check:fast": "pnpm typecheck && pnpm lint && pnpm format:check && node scripts/floor-guard.mjs",
    "check:task": "pnpm check:fast && pnpm coverage",
    "check:full": "pnpm check:task && VITE_SERVER_URL=http://localhost:3001 pnpm build",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm --filter @clave/shared test",
    "commit-msg": "node scripts/floor-guard.mjs --staged --commit-msg \"$1\""
  }
}
